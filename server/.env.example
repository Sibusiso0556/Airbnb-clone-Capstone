MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/airbnb-clone
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
NODE_ENV=development

# Optional — if set, listing image uploads go to Cloudinary instead of local disk.
# Recommended for any deployed (e.g. Heroku) environment since local disk storage
# does not survive a dyno restart. Get this from your Cloudinary dashboard.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
